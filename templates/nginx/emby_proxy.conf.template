# /etc/nginx/conf.d/emby_proxy.conf (V4 - .strm 精准捕获最终版)

# Temporary VidHub diagnostic trace.  Only allow-listed query values are
# recorded; authorization headers and token/api-key query parameters are never
# included.
log_format vidhub_trace escape=json
    '[VIDHUB_TRACE] {"source":"nginx","method":"$request_method",'
    '"path":"$uri","parent_id":"$arg_ParentId",'
    '"include_item_types":"$arg_IncludeItemTypes","recursive":"$arg_Recursive",'
    '"fields":"$arg_Fields","sort_by":"$arg_SortBy",'
    '"collection_type":"$arg_CollectionType","user_agent":"$http_user_agent",'
    '"status":$status,"bytes":$body_bytes_sent,"elapsed":$request_time}';

upstream emby_server {
    server {{ EMBY_UPSTREAM }};
}

upstream virtual_library_proxy {
    server {{ PROXY_UPSTREAM }};
}

{% if REDIRECT_UPSTREAM %}
upstream redirect_service {
    server {{ REDIRECT_UPSTREAM }};
}
{% endif %}

server {
    listen {{ NGINX_LISTEN_PORT }};
    server_name your.domain.com;
    access_log /dev/stdout vidhub_trace;

    # --- 基础代理参数 ---
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "Upgrade";
    proxy_buffering off;

    # ====================================================================
    #  核心路由规则 (V4)
    # ====================================================================

    # ★★★ 规则 1：【条件化】转发所有视频流请求 ★★★
    # 如果设置了 REDIRECT_UPSTREAM，此规则块将生效。
    # 它会捕获所有主流视频格式、转码流和 .strm 文件，并因为位置靠前而被优先匹配。
    {% if REDIRECT_UPSTREAM %}
    location ~* (\.strm$|\.(mkv|mp4|ts|avi|iso|mov|webm|flv)$|/videos/.*stream) {
        proxy_pass http://redirect_service;
    }
    {% endif %}

    # --- 以下是虚拟库路由规则 ---

    location ~ ^/(emby/)?Users/([a-f0-9]+)/Views$ {
        proxy_pass http://virtual_library_proxy;
    }

    # Infuse Direct performs a second native-library discovery pass through
    # VirtualFolders. Route only that proven client family through the same EVH
    # exact-ID visibility contract; every other client keeps the native path.
    location ~ ^/(emby/)?Library/VirtualFolders$ {
        if ($http_user_agent ~* "^Infuse-Direct/") {
            proxy_pass http://virtual_library_proxy;
        }
        proxy_pass http://emby_server;
    }

    # Only virtual catalogue requests pass through the Python proxy. Native
    # libraries retain the established direct Emby path.
    location ~ ^/(emby/)?Users/([a-f0-9]+)/Items$ {
        if ($arg_ParentId ~ ^-\d+$) {
            proxy_pass http://virtual_library_proxy;
        }
        proxy_pass http://emby_server;
    }

    # 规则 3a：虚拟 View 详情同时兼容带/不带 /emby 前缀的客户端。
    location ~ ^/(emby/)?Users/[^/]+/Items/-(\d+)$ {
        proxy_pass http://virtual_library_proxy;
    }

    # 规则 3b：保持现有带 /emby 前缀的虚拟图片等请求处理。
    location ~ ^/emby/Items/-(\d+) {
        proxy_pass http://virtual_library_proxy;
    }

    # Infuse Direct 请求虚拟 View 主图时不带 /emby 前缀和 tag。
    # 仅拦截精确的负数虚拟 View Primary 图片路径，避免影响原生项目图片。
    location ~ ^/Items/-(\d+)/Images/Primary$ {
        proxy_pass http://virtual_library_proxy;
    }

    # 规则 4：拦截虚拟库内的“元数据筛选”和“最新添加”请求
    location ~ /Items/(Prefixes|Genres|Studios|Tags|OfficialRatings|Years|Latest)$ {
        if ($arg_ParentId ~ ^-\d+$) {
            proxy_pass http://virtual_library_proxy;
        }
        if ($arg_customViewId ~ ^-\d+$) {
            proxy_pass http://virtual_library_proxy;
        }
        proxy_pass http://emby_server;
    }

    # 规则 5: WebSocket (保持不变)
    location /embywebsocket {
        proxy_pass http://emby_server;
    }

    # 兜底规则：转发所有其他请求到真实 Emby
    location / {
        proxy_pass http://emby_server;
    }
}
